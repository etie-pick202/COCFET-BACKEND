# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Base de données (PostgreSQL 15)
DATABASE_URL=postgresql://user:password@localhost:5432/cocfet_dev
DATABASE_SSL=false

# Authentification JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# SSO UCAC-ICAM
UCAC_OAUTH_CLIENT_ID=
UCAC_OAUTH_CLIENT_SECRET=
UCAC_OAUTH_CALLBACK_URL=

# Rate limiting (Upstash Redis) — laisser vide pour désactiver en local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Emails
# Développement : Mailpit (docker compose up -d), aucun compte ni quota.
#   Les messages capturés se consultent sur http://localhost:8025
#   MAIL_USER et MAIL_PASSWORD restent vides : Mailpit n'exige pas d'authentification.
# Staging / production : Brevo — voir docs/SECRETS.md
#   MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="COCFET <no-reply@cocfet.com>"

# Stockage fichiers (Cloudflare R2, compatible S3)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=cocfet
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Paiement Mobile Money (NotchPay)
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_SECRET_KEY=
# Sert à vérifier la signature des webhooks : sans lui, n'importe qui pourrait
# marquer une commande comme payée.
NOTCHPAY_WEBHOOK_SECRET=

# Monitoring
SENTRY_DSN=
