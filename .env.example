# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# Base de données (PostgreSQL 15)
DATABASE_URL=postgresql://user:password@localhost:5432/cocfet_dev
DATABASE_SSL=false
# Certificat de l'autorité de l'hébergeur, si celui-ci n'utilise pas une AC publique.
DATABASE_SSL_CA=
# À ne passer à false qu'en dernier recours : cela désactive la vérification du
# certificat et expose la connexion aux attaques de l'homme du milieu.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Prototypage local uniquement, et sans effet hors NODE_ENV=development :
# synchronize supprime les colonnes disparues des entites, donc des donnees.
# Le schema est gere par migrations, voir docs/MIGRATIONS.md
DATABASE_SYNCHRONIZE=false
# Trace de toutes les requetes SQL. A n'activer que le temps d'un diagnostic :
# une seule tache planifiee a la minute suffit a noyer la console. Par defaut,
# seules les erreurs et les requetes de plus de 500 ms sont affichees.
DATABASE_LOGGING=false

# Mot de passe du compte administrateur cree par « pnpm run seed ».
# Volontairement absent du code : ce depot est public, et un mot de passe
# commite vaudrait pour tout environnement ayant joue ce seed.
# A entourer de guillemets : sans eux, un « # » en debut de valeur serait lu
# comme un commentaire et la variable resterait vide.
SEED_ADMIN_PASSWORD=

# Authentification JWT
# Ces deux valeurs ne s'obtiennent nulle part : on les genere soi-meme, une
# paire par environnement, avec « openssl rand -base64 48 ».
# L'application refuse de demarrer si l'une fait moins de 32 caracteres, si
# elle reprend une valeur d'exemple, ou si les deux sont identiques — un
# refresh token vaudrait alors jeton d'acces pendant sept jours.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Signature des codes de billet tournants. Facultatif : a defaut, la cle est
# derivee de JWT_ACCESS_SECRET. La renseigner permet de la faire tourner sans
# invalider les sessions ouvertes. Meme longueur minimale que les autres.
# Laissee commentee : renseignee a vide, elle echouerait la validation au
# demarrage au lieu de retomber sur la derivation.
# QR_SECRET=

# Rate limiting (Upstash Redis) — laisser vide pour désactiver en local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Emails
# Développement : Mailpit (docker compose up -d), aucun compte ni quota.
#   Les messages capturés se consultent sur http://localhost:8025
#   MAIL_USER et MAIL_PASSWORD restent vides : Mailpit n'exige pas d'authentification.
# Staging / production : Brevo par son API HTTP — voir docs/SECRETS.md
#   Renseigner BREVO_API_KEY suffit : elle l'emporte sur les variables MAIL_*
#   ci-dessous, et l'envoi passe alors en HTTPS. C'est obligatoire sur Railway,
#   qui filtre les ports SMTP sortants : une connexion vers
#   smtp-relay.brevo.com:587 depuis un conteneur n'aboutit jamais.
#   MAIL_FROM doit être un expéditeur validé dans Brevo, sur un domaine
#   vérifié. Une adresse @gmail.com ne convient pas : la politique DMARC de
#   Gmail fait alors mettre le message en quarantaine chez le destinataire.
BREVO_API_KEY=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="COCFET <no-reply@cocfet.com>"

# Stockage fichiers (Cloudflare R2, compatible S3)
# Laisser ces quatre variables vides bascule sur le stockage local : les
# fichiers atterrissent dans STOCKAGE_LOCAL_DIR et sont servis par des URL
# signées expirantes, comme le ferait R2. Il suffit de les renseigner toutes
# les quatre pour passer au stockage distant, sans changer une ligne de code.
# Elles sont en revanche obligatoires en production : le disque local ne
# survit pas a un redeploiement.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STOCKAGE_LOCAL_DIR=var/stockage

# Paiement Mobile Money (Fapshi)
# Laisser les trois variables vides bascule sur la passerelle factice : aucun
# argent ne circule, et l'issue est pilotee par le numero, avec les memes
# valeurs que le bac a sable Fapshi (670000000 reussit, 670000001 echoue,
# tout autre numero reste en attente). Elles sont en revanche obligatoires en
# production — encaisser avec la passerelle factice reviendrait a livrer des
# billets sans debiter personne.
#
# Renseigner les identifiants du bac a sable eprouve le vrai adaptateur en
# local, ce que la passerelle factice ne fait pas.
# Bac a sable : https://sandbox.fapshi.com — production : https://live.fapshi.com
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Secret pose sur le tableau de bord Fapshi, service par service. Fapshi le
# renvoie dans l'en-tete « x-wh-secret » de chaque notification.
# ⚠️ Le tableau de bord ne permet pas de le relire ensuite : notez-le au
# moment ou vous le posez.
FAPSHI_WEBHOOK_SECRET=

# Reconciliation des paiements. En paiement direct, l'issue n'arrive que par
# webhook : un webhook perdu laisserait l'inscription en attente pour
# toujours, place bloquee et argent debite. Une tache interroge donc le
# prestataire toutes les cinq minutes.
# Delai de grace avant le premier examen — le temps que la personne valide sur
# son telephone.
PAIEMENT_DELAI_GRACE_MINUTES=3
# Au-dela, un paiement toujours en attente chez le prestataire est abandonne
# et la place rendue. Arbitrage entre deux torts : trop court, on annule
# quelqu'un qui cherchait son telephone ; trop long, une place reste bloquee.
PAIEMENT_DELAI_EXPIRATION_MINUTES=30

# Monitoring
SENTRY_DSN=
