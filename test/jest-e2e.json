{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "//": "Un seul worker : chaque fichier monte l'application, qui joue les migrations au demarrage. En parallele, deux instances tentent de creer les memes tables et l'une echoue. Elles partagent en outre la meme base.",
  "maxWorkers": 1,
  "collectCoverageFrom": [
    "src/**/*.ts"
  ],
  "coveragePathIgnorePatterns": [
    "/node_modules/",
    "src/main.ts",
    "src/migrations/",
    "src/seed/",
    "\\.module\\.ts$",
    "\\.dto\\.ts$",
    "\\.entity\\.ts$",
    "\\.enum\\.ts$"
  ],
  "coverageDirectory": "coverage-e2e",
  "coverageReporters": [
    "text-summary",
    "lcov"
  ]
}
