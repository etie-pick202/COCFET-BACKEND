# Domaines servis par Caddy — /opt/cocfet/edge/.env
#
# Chaque domaine doit avoir un enregistrement DNS A (et AAAA si IPv6) vers
# l'adresse de la VPS AVANT le démarrage de Caddy, sans quoi Let's Encrypt
# refuse de délivrer le certificat.

# Adresse de contact Let's Encrypt : avertissements d'expiration et de
# révocation.
EMAIL_ACME=

DOMAINE_FRONT_PRODUCTION=cocfet.example
DOMAINE_API_PRODUCTION=api.cocfet.example

DOMAINE_FRONT_STAGING=staging.cocfet.example
DOMAINE_API_STAGING=api.staging.cocfet.example
