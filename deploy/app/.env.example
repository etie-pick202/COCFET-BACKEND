# Variables de l'environnement Compose — /opt/cocfet/<environnement>/.env
#
# Créé automatiquement par deploy/scripts/preparer-vps.sh, avec un mot de passe
# de base généré. Ce modèle ne sert qu'à documenter son contenu : il n'y a
# normalement rien à y saisir à la main.

# staging ou production. Donne son nom au projet Compose (cocfet-staging…) et
# aux alias que Caddy utilise pour joindre l'API et le frontend.
ENVIRONNEMENT=staging

# Base PostgreSQL de cet environnement, propre à lui seul.
# Le mot de passe est en hexadécimal : il entre tel quel dans DATABASE_URL.
POSTGRES_USER=cocfet
POSTGRES_PASSWORD=
POSTGRES_DB=cocfet

# Versions en service. Tenues à jour par deploy/scripts/deployer.sh, qui s'en
# sert aussi pour revenir à la précédente si la nouvelle ne démarre pas.
BACKEND_TAG=aucun
FRONTEND_TAG=aucun

# Plafonds mémoire. Ils protègent un environnement de l'autre : une fuite en
# recette ne doit pas priver la production de mémoire.
POSTGRES_MEMOIRE=512M
BACKEND_MEMOIRE=512M
FRONTEND_MEMOIRE=512M
