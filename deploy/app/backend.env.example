# Secrets de l'API — /opt/cocfet/<environnement>/backend.env
#
# À remplir sur la VPS, un fichier par environnement, jamais versionné.
# Voir docs/SECRETS.md pour l'origine de chaque valeur.
#
# Ne pas y mettre DATABASE_URL, DATABASE_SSL*, NODE_ENV, PORT ni TRUST_PROXY :
# deploy/app/docker-compose.yml les impose, et ils l'emportent de toute façon
# sur ce fichier.

API_PREFIX=api/v1

# URL exacte du frontend de CET environnement, sans barre finale.
# Recette : https://staging.<domaine>   Production : https://<domaine>
CORS_ORIGIN=

# Documentation Swagger sur /docs. Utile en recette pour l'équipe frontend ;
# à laisser fermée en production, où elle décrit la surface d'attaque.
SWAGGER_ENABLED=false

# Une paire distincte par environnement : « openssl rand -base64 48 ».
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Limitation de débit (Upstash). Obligatoire : l'API refuse de démarrer sans.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Emails : relais SMTP de Brevo d'abord (seul à afficher le logo et le QR dans
# le message), API HTTP en recours. MAIL_PASSWORD est la clé SMTP xsmtpsib-…,
# pas la clé API. MAIL_FROM sur un domaine vérifié (SPF, DKIM).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
BREVO_API_KEY=
MAIL_FROM=COCFET <contact@cocfet-ucac-icam.com>

# Fichiers (Cloudflare R2). Obligatoires : l'API refuse de démarrer sans.
# Un bucket par environnement — cocfet-staging, cocfet-prod — avec un jeton
# restreint à ce seul bucket.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Paiement. Recette : service de bac à sable (https://sandbox.fapshi.com) pour
# ne jamais encaisser de vrai argent en testant. Production : service live.
# Webhook à déclarer côté Fapshi : https://<domaine de l'API>/api/v1/webhooks/fapshi
FAPSHI_BASE_URL=
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=
PAIEMENT_DELAI_GRACE_MINUTES=3
PAIEMENT_DELAI_EXPIRATION_MINUTES=30

# Frais répercutés sur l'acheteur : laisser vides pour les taux par défaut,
# voir src/modules/paiement/frais-paiement.ts.
FAPSHI_TAUX_FRAIS=
RETRAIT_MOMO_TAUX=
RETRAIT_MOMO_FIXE=
RETRAIT_OM_TAUX=
RETRAIT_OM_FIXE=

SENTRY_DSN=
