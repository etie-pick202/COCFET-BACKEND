{{!--
  Bouton secondaire : contour aux couleurs du mandat, fond blanc. Pour une
  action proposée sans être attendue. Mêmes paramètres que « bouton ».
--}}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0 0">
  <tr>
    <td
      style="background:#FFFFFF;border:1px solid {{charte.couleurPrimaire}};border-radius:6px;padding:13px 28px"
    >
      <a
        href="{{lien}}"
        style="color:{{charte.couleurPrimaire}};font-weight:600;text-decoration:none;font-size:15px;line-height:1.2;display:inline-block"
        >{{libelle}}</a
      >
    </td>
  </tr>
</table>
