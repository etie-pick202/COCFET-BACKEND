{{!--
  Encart d'information, teinté de la couleur secondaire du mandat.
  S'utilise en bloc : {{#> encart-info titre="..."}}contenu{{/encart-info}}.
--}}
<table
  role="presentation"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  style="margin:{{#if marge}}{{marge}}{{else}}20px 0 0{{/if}};border-collapse:separate"
>
  <tr>
    <td
      style="background:{{charte.teinte}};border:1px solid {{charte.bordTeinte}};border-radius:8px;padding:16px 20px"
    >
      <div
        style="font-size:11px;letter-spacing:1.4px;font-weight:700;color:#1C1917;margin-bottom:6px;text-transform:uppercase"
      >{{titre}}</div>
      <div style="font-size:14.5px;line-height:1.6;color:#292524">{{> @partial-block}}</div>
    </td>
  </tr>
</table>
