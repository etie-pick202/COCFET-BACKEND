{{!--
  Fiche clé / valeur sur fond crème. S'utilise en bloc, les lignes étant des
  appels à « ligne-fiche » :
  {{#> fiche}}{{> ligne-fiche cle="..." valeur=...}}{{/fiche}}
--}}
<table
  role="presentation"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  style="margin:0 0 4px;background:#FAF8F4;border:1px solid #EEEAE2;border-radius:8px;border-collapse:separate"
>
  <tr>
    <td style="padding:6px 20px">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        {{> @partial-block}}
      </table>
    </td>
  </tr>
</table>
