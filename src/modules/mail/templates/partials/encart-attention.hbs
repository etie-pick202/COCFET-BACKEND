{{!--
  Encart de mise en garde : ce qu'il faut savoir pour que rien ne bloque.
  S'utilise en bloc : {{#> encart-attention titre="..."}}contenu{{/encart-attention}}.
--}}
<table
  role="presentation"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  style="margin:{{#if marge}}{{marge}}{{else}}20px 0 0{{/if}};border-collapse:separate"
>
  <tr>
    <td
      style="background:#FFF8EB;border:1px solid #F5D9A6;border-radius:8px;padding:16px 20px"
    >
      <div
        style="font-size:11px;letter-spacing:1.4px;font-weight:700;color:#92400E;margin-bottom:6px;text-transform:uppercase"
      >{{titre}}</div>
      <div style="font-size:14.5px;line-height:1.6;color:#292524">{{> @partial-block}}</div>
    </td>
  </tr>
</table>
